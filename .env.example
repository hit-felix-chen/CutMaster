# Copy this file to .env in the same directory as config.toml.
# CutMaster loads it automatically at CLI startup without overriding variables
# that are already present in the process environment.
# Default, cost-conscious setup: DeepSeek for the LLM, DashScope for VLM and ASR.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# Simpler setup: switch the commented LLM alternative in config.toml to
# qwen3.7-max, then only DASHSCOPE_API_KEY is required.

# Optional: authenticates Demucs model downloads from Hugging Face.
HF_TOKEN=
